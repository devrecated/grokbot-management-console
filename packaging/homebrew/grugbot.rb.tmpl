# Template for OWNER/homebrew-tap Formula/grugbot.rb. goreleaser writes this for you when
# HOMEBREW_TAP_TOKEN is set; this copy is for doing it by hand. Fill VERSION and the sha256 values
# from checksums.txt of the GitHub release.
class Grugbot < Formula
  desc "Set up the GrugBot Console on Vercel"
  homepage "https://github.com/OWNER/grokbot-routines"
  version "VERSION"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/OWNER/grokbot-routines/releases/download/vVERSION/grugbot_VERSION_darwin_arm64.tar.gz"
      sha256 "SHA256_DARWIN_ARM64"
    end
    on_intel do
      url "https://github.com/OWNER/grokbot-routines/releases/download/vVERSION/grugbot_VERSION_darwin_amd64.tar.gz"
      sha256 "SHA256_DARWIN_AMD64"
    end
  end
  on_linux do
    on_arm do
      url "https://github.com/OWNER/grokbot-routines/releases/download/vVERSION/grugbot_VERSION_linux_arm64.tar.gz"
      sha256 "SHA256_LINUX_ARM64"
    end
    on_intel do
      url "https://github.com/OWNER/grokbot-routines/releases/download/vVERSION/grugbot_VERSION_linux_amd64.tar.gz"
      sha256 "SHA256_LINUX_AMD64"
    end
  end

  def install
    bin.install "grugbot"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/grugbot version")
  end
end
